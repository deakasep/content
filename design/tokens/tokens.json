          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "fluid = clamp(mobile, …, desktop). Mobile < 768px, desktop >= 1024px.",
      "display": {
        "$value": "clamp(2rem, 1.2rem + 2.5vw, 3rem)",
        "mobile": "2rem",
        "desktop": "3rem"
      },
      "h2": {
        "$value": "clamp(1.75rem, 1.3rem + 1.4vw, 2.25rem)",
        "mobile": "1.75rem",
        "desktop": "2.25rem"
      },
      "h3": {
        "$value": "clamp(1.5rem, 1.2rem + 0.9vw, 1.875rem)",
        "mobile": "1.5rem",
        "desktop": "1.875rem"
      },
      "h4": {
        "$value": "clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem)",
        "mobile": "1.25rem",
        "desktop": "1.5rem"
      },
      "h5": {
        "$value": "clamp(1.125rem, 1.05rem + 0.25vw, 1.25rem)",
        "mobile": "1.125rem",
        "desktop": "1.25rem"
      },
      "h6": {
        "$value": "clamp(1rem, 0.95rem + 0.2vw, 1.125rem)",
        "mobile": "1rem",
        "desktop": "1.125rem"
      },
      "body": {
        "$value": "1rem"
      },
      "small": {
        "$value": "0.875rem"
      },
      "tiny": {
        "$value": "0.75rem"
